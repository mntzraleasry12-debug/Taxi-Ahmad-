@charset "utf-8";

:root { --primary: #FFC107; --primary-dark: #FFA000; --primary-light: #FFF8E1; --bg-body: #121212; --bg-app: #F8F9FA; --white: #FFFFFF; --dark: #1A1A1A; --text-main: #222222; --text-muted: #777777; --border-color: #EEEEEE; --success: #00C853; --danger: #FF3B30; --info: #2196F3; --shadow-sm: 0 2px 8px rgba(0,0,0,0.06); --shadow-md: 0 6px 16px rgba(0,0,0,0.1); --shadow-lg: 0 12px 32px rgba(0,0,0,0.15); --shadow-glow: 0 0 20px rgba(255, 193, 7, 0.4); --radius-sm: 12px; --radius-md: 20px; --radius-lg: 32px; --radius-round: 50%; --transition-fast: 0.2s ease; --transition-normal: 0.3s ease; --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1); }

* { margin: 0px; padding: 0px; box-sizing: border-box; -webkit-tap-highlight-color: transparent; font-family: Tajawal, sans-serif; user-select: none; }

html, body { height: 100%; width: 100%; overflow: hidden; background-color: var(--bg-body); display: flex; justify-content: center; align-items: center; }

.app-container { width: 100%; max-width: 430px; height: 100%; max-height: 932px; background-color: var(--bg-app); position: relative; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.5) 0px 25px 50px -12px; display: flex; flex-direction: column; }

@media (min-width: 500px) {
  .app-container { height: 90vh; border-radius: 40px; border: 10px solid rgb(51, 51, 51); }
}

#login-screen { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; z-index: 10000; background: linear-gradient(145deg, rgb(17, 17, 17) 0%, rgb(34, 34, 34) 100%); display: flex; flex-direction: column; transition: transform 0.6s cubic-bezier(0.85, 0, 0.15, 1); }

#login-screen.slide-up { transform: translateY(-100%); }

.glow-1 { position: absolute; top: -50px; right: -50px; width: 250px; height: 250px; background: var(--primary); filter: blur(100px); opacity: 0.2; border-radius: 50%; }

.glow-2 { position: absolute; bottom: -50px; left: -50px; width: 200px; height: 200px; background: var(--primary-dark); filter: blur(100px); opacity: 0.15; border-radius: 50%; }

.login-branding { flex: 1 1 0%; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; z-index: 2; }

.logo-icon { font-size: 70px; color: var(--primary); margin-bottom: 20px; animation: 3s ease-in-out 0s infinite normal none running floatTaxi; text-shadow: rgba(255, 193, 7, 0.3) 0px 10px 20px; }

@keyframes floatTaxi { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-15px); }
}

.login-title { font-size: 48px; font-weight: 900; color: var(--white); letter-spacing: -1px; }

.login-title span { color: var(--primary); }

